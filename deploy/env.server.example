# Server .env — copy to /opt/seoos/app/.env and fill in.
#
# Read by two things with different parsers, which constrains the format:
#   · pydantic-settings (packages/core/config.py) for the API and worker
#   · systemd EnvironmentFile= for the web app
#
# systemd is the fussier of the two. Keep every value on one line, unquoted, with
# no trailing comments. A '#' is a comment only at the start of a line.

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres runs in Docker via the repo-root docker-compose.yml, bound to
# 127.0.0.1. Never publish 5432 — Docker's iptables rules are inserted ahead of
# ufw, so a 0.0.0.0 bind is reachable from the internet even with the firewall
# "closed".
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32

# TWO URLS, AND THE DIFFERENCE IS A SECURITY BOUNDARY.
#
# DATABASE_URL is the application role, seoos_app. It is neither superuser nor
# table owner, which is the only reason the RLS policies apply to it. Point this
# at `seoos` (owner) or `postgres` (superuser) and every organisation reads every
# other organisation's data — silently, with no error and no log line. The
# dashboard query has no org_id filter of its own; RLS *is* the filter.
#
# ADMIN_DATABASE_URL is the owner, used by Alembic only. seoos_app has no CREATE.
#
# tests/isolation/test_app_role.py enforces this. Run it after any change here.
DATABASE_URL=postgresql://seoos_app:CHANGE_ME_app_role_password@127.0.0.1:5432/seoos
ADMIN_DATABASE_URL=postgresql://seoos:CHANGE_ME_openssl_rand_hex_32@127.0.0.1:5432/seoos

# ⚠ infra/postgres/init.sql creates seoos_app with the hardcoded password
#   'seoos_local_dev'. That is fine on a laptop and unacceptable on a public
#   server. bootstrap.sh rotates it with ALTER ROLE after first start; the value
#   you set in DATABASE_URL above must match what it rotated to.

# ── Secrets ──────────────────────────────────────────────────────────────────
# COPY THESE FROM YOUR MAC'S .env — do not generate fresh ones.
#
# TOKEN_ENCRYPTION_KEY decrypts stored Google refresh tokens. A new key does not
# lose the database; it orphans every oauth_connections row, and every client has
# to reconnect. There is no way to recover the old tokens without the old key.
#
# A fresh SESSION_SECRET only forces everyone to sign in again.
#
# Generate (first deployment only): openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=COPY_FROM_MAC
SESSION_SECRET=COPY_FROM_MAC

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Same client as local. Add the https redirect URIs in Google Cloud Console —
# BOTH of them, see deploy/README.md §5.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── URLs ─────────────────────────────────────────────────────────────────────
# Both must be the SAME https origin. Caddy serves the API and the web app from
# one hostname so the session cookie stays same-site; two hostnames means the
# browser silently drops it on every API call.
#
# API_URL's scheme also drives the cookie's Secure flag (config.py cookie_secure)
# and is baked into the browser bundle at build time by next.config.mjs — so
# update.sh must have it exported before `next build` runs.
API_URL=https://seo.yourdomain.com
WEB_URL=https://seo.yourdomain.com

# Server-side health probe target, used by the login page to tell you the API is
# down instead of handing you a dead link. Stays on the loopback so /health never
# has to be exposed through Caddy, and so the probe costs no TLS handshake.
INTERNAL_API_URL=http://127.0.0.1:8000

# ── App ──────────────────────────────────────────────────────────────────────
# 'prod-local' is the literal string config.py's is_prod compares against.
# 'prod' or 'production' silently leave the app in dev mode.
ENV=prod-local
LOG_LEVEL=info

# ── Ollama — inert until packages/ai/ exists ─────────────────────────────────
# Phase 2 only, and see deploy/README.md §7 before assuming these will work on a
# server: no cloud host at this price has a GPU, and CPU inference for a 9B model
# is 8-15x slower (docs/10-deployment.md §32).
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_KEEP_ALIVE=5m
OLLAMA_THINK=false

# ── Paid adapters — leave blank ──────────────────────────────────────────────
# Filling either puts a subscription in a default code path, which CLAUDE.md
# rule 1 forbids. They exist behind SerpProvider / LLMProvider, off by default.
APIFY_TOKEN=
REMOTE_LLM_API_KEY=
