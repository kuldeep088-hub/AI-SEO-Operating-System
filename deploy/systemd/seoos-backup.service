[Unit]
Description=AI SEO OS — nightly backup
Documentation=file:///opt/seoos/app/deploy/README.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=seoos
Group=seoos
WorkingDirectory=/opt/seoos/app
EnvironmentFile=/opt/seoos/app/.env

# backup.sh cds to its own directory and runs `docker compose exec -T postgres
# pg_dump`, so it must run from the repo root where docker-compose.yml lives,
# as a user in the docker group. bootstrap.sh puts seoos in that group.
#
# It writes to ./backups (hardcoded, and .gitignored). bootstrap.sh symlinks
# that to /opt/seoos/backups so archives survive re-cloning the repo.
ExecStart=/opt/seoos/app/backup.sh

# .tar.zst, not .tar.gz — backup.sh compresses with zstd.
#
# The archive contains .env, and therefore TOKEN_ENCRYPTION_KEY. Anyone holding
# it can decrypt every stored OAuth token. 0600 and treat it as a credential.
ExecStartPost=/bin/sh -c 'chmod 600 /opt/seoos/backups/*.tar.zst 2>/dev/null || true'
ExecStartPost=/usr/bin/find /opt/seoos/backups -name '*.tar.zst' -mtime +14 -delete

NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=seoos-backup
