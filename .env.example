# Copy to .env — setup.sh does this and generates the secrets below.
# NEVER commit .env. Losing TOKEN_ENCRYPTION_KEY orphans every OAuth connection.

# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=seoos_local_dev
DATABASE_URL=postgresql://seoos:seoos_local_dev@127.0.0.1:5432/seoos

# ── Secrets (generated by setup.sh — do not fill in by hand) ──────────────
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=

# ── Google OAuth ──────────────────────────────────────────────────────────
# From your own Google Cloud project. See docs/14-execution.md §60.
# Authorised redirect URI: http://localhost:8000/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── URLs ──────────────────────────────────────────────────────────────────
API_URL=http://localhost:8000
WEB_URL=http://localhost:3000

# ── Ollama (local, $0) ────────────────────────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_KEEP_ALIVE=30m
OLLAMA_THINK=0

# ── Optional paid adapters — leave blank to stay at $0 ───────────────────
# See docs/07-ai-architecture.md §17 and docs/11-costs.md §38.
APIFY_TOKEN=
REMOTE_LLM_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────
ENV=dev
LOG_LEVEL=info
